{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk-score.v1",
  "title": "RiskScoreEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_ver",
    "chain_id",
    "created_at",
    "idempotency_key",
    "tx_hash",
    "score",
    "severity",
    "reasons",
    "model_version",
    "feature_ver",
    "threshold_profile"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "schema_ver": {"const": "risk-score.v1"},
    "chain_id": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "tx_hash": {"type": "string", "pattern": "^0x[a-fA-F0-9]{64}$"},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "severity": {
      "type": "string",
      "enum": ["low", "watch", "high", "critical"]
    },
    "reasons": {"type": "array", "items": {"type": "string"}},
    "rule_scores": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "model_version": {"type": "string", "minLength": 1},
    "feature_ver": {"type": "string", "minLength": 1},
    "threshold_profile": {"type": "string", "minLength": 1},
    "model_reject_reason": {"type": ["string", "null"]}
  }
}
