{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-explanation.v1",
  "title": "RagExplanationEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_ver",
    "chain_id",
    "created_at",
    "idempotency_key",
    "alert_id",
    "tx_hash",
    "graph_summary",
    "doc_summary",
    "analyst_note",
    "evidence_refs",
    "knowledge_snapshot"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "schema_ver": {"const": "rag-explanation.v1"},
    "chain_id": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "alert_id": {"type": "string", "minLength": 1},
    "tx_hash": {"type": "string", "pattern": "^0x[a-fA-F0-9]{64}$"},
    "graph_summary": {"type": "string"},
    "doc_summary": {"type": "string"},
    "analyst_note": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "knowledge_snapshot": {"type": "string", "minLength": 1},
    "rag_model": {"type": ["string", "null"]},
    "timeout": {"type": "boolean"}
  }
}
